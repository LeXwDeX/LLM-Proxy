  "narrative": {
    "northStar": "深蓝侧栏里的清晰工作面",
    "overview": "这是一个面向中文运维工作的管理界面：稳定的深蓝导航为浅色内容区提供清楚边界，蓝色动作色标出可操作位置，内容以易扫读的数字、表格和分区面板为主。整体使用系统无衬线字体，信息密度偏高但层次直接，适合长时间查看和维护配置。\n\n首页把全站活动、双趋势图和客户端明细放在同一条工作流中。图表中的输入、输出和并发各有颜色标记；表格仍是识别并切换客户端的主要入口。全站统计保持可见，历史完成统计和费用作为次级信息折叠展示。",
    "keyCharacteristics": [
      "深蓝侧栏与浅灰工作区形成稳定的框架。",
      "明亮蓝色标识主要操作和选中状态。",
      "以数字、趋势和可排序表格组织高密度运营信息。",
      "系统中文字体保持各平台自然呈现。"
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "蓝色是主要交互强调色；输入、输出和并发趋势使用各自的图例颜色，不以颜色作为唯一的数据区分方式，输出线同时使用虚线。",
        "section": "colors"
      },
      {
        "name": "The Readable Numbers Rule",
        "body": "计数和时间读数使用表格数字，避免刷新或对齐变化妨碍比较。",
        "section": "typography"
      },
      {
        "name": "The Border Before Shadow Rule",
        "body": "静态内容先靠表面和细边框分组；更明显的阴影留给悬停或浮层。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 使用深蓝侧栏、浅色内容区和蓝色主要操作色维持页面框架。",
      "Do 通过文字、单位和图例说明数据含义，不只依赖颜色。",
      "Do 为数据表保留清楚的列对齐、分隔线和可见排序状态。",
      "Do 在窄屏缩小间距并保留表格横向浏览能力。",
      "Do 让键盘聚焦状态与悬停状态同样清楚。"
    ],
    "donts": [
      "Don't 用大面积饱和色替代浅色工作区。",
      "Don't 让颜色成为输入、输出或并发数据的唯一识别方式。",
      "Don't 用持续动画或滚动计数干扰实时读数。",
      "Don't 把全站样式规则误当成要求其他页面采用首页图表布局。"
    ]
  }
}
